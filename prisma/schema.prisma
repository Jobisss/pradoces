// Luizinha Confeitaria — Prisma 7 schema (Phase 1 foundation models).
//
// Conventions locked in 01-CONTEXT.md (D-09) / 01-PATTERNS.md:
//   - UUID primary keys: `String @id @default(uuid()) @db.Uuid`
//   - snake_case table/column names via `@@map` / `@map`
//   - All timestamps: `DateTime @db.Timestamptz(6)` (TZ=America/Sao_Paulo at runtime)
//   - Money columns (Phase 2+): `Decimal @db.Decimal(19, 4)` — NEVER float (T-Float-01).
//     Phase 1 has zero money columns; the convention is documented here so Phase 2
//     (Ingrediente / Receita / Lote) inherits it without re-deciding.
//   - Raw Postgres features (triggers, CHECK XOR, event-sourced frozen cost) use
//     `prisma.$queryRaw` template literals (auto-parameterized — T-SQLi-01).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  // Prisma 7 removed `url` from the datasource block. The connection string now
  // lives in `prisma.config.ts` (datasource.url) for Migrate/CLI, and the
  // PrismaClient receives a driver adapter (@prisma/adapter-pg) at runtime
  // (see lib/db/client.ts). See https://pris.ly/d/config-datasource
  provider = "postgresql"
}

enum Role {
  admin
  customer
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  name              String
  telefone          String?
  role              Role      @default(customer)
  isAdult           Boolean   @default(false) @map("is_adult")
  termsVersion      String?   @map("terms_version")
  termsAcceptedAt   DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  privacyVersion    String?   @map("privacy_version")
  privacyAcceptedAt DateTime? @map("privacy_accepted_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  anonymizedAt      DateTime? @map("anonymized_at") @db.Timestamptz(6)
  // Better Auth admin plugin fields (input:false — set only via admin APIs).
  banned            Boolean   @default(false)
  banReason         String?   @map("ban_reason")
  banExpires        DateTime? @map("ban_expires") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions      Session[]
  accounts      Account[]
  verifications Verification[]

  @@map("users")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  token          String   @unique
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  // Better Auth admin plugin — set when an admin impersonates a user.
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  emailInvalid          Boolean   @default(false) @map("email_invalid")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@map("verifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipHash     String?  @map("ip_hash")
  uaHash     String?  @map("ua_hash")
  ts         DateTime @default(now()) @db.Timestamptz(6)

  @@index([ts(sort: Desc)])
  @@index([action])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Phase 2: Motor Financeiro (domain models — 02-01-PLAN.md)
//
// Core invariant: frozen cost is enforced in the SCHEMA, not by app convention
// (Pitfall 5.5). `lote_uso_ingredientes.ingrediente_compra_id` is a NOT NULL FK
// to the PURCHASE (never to the ingredient); `trg_compra_imutavel` (custom SQL
// appended to the generated migration) blocks UPDATE/DELETE on a purchase once
// referenced by a lote. CHECK constraints (also custom SQL) keep lote stock
// columns non-negative and `configuracoes` a true singleton.
// ---------------------------------------------------------------------------

enum UnidadeBase {
  g
  ml
  un
}

enum TipoIngrediente {
  INGREDIENTE
  EMBALAGEM
}

enum TipoProduto {
  UNITARIO
  KIT
}

model Ingrediente {
  id           String               @id @default(uuid()) @db.Uuid
  nome         String               @unique
  unidadeBase  UnidadeBase          @map("unidade_base")
  tipo         TipoIngrediente      @default(INGREDIENTE)
  criadoEm     DateTime             @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  compras      IngredienteCompra[]
  receitaItens ReceitaIngrediente[]

  @@map("ingredientes")
}

model IngredienteCompra {
  id                  String   @id @default(uuid()) @db.Uuid
  ingredienteId       String   @map("ingrediente_id") @db.Uuid
  dataCompra          DateTime @map("data_compra") @db.Date
  mercado             String
  marca               String
  qtdeEmbalagens      Decimal  @map("qtde_embalagens") @db.Decimal(10, 3)
  tamanhoEmbalagem    Decimal  @map("tamanho_embalagem") @db.Decimal(12, 3)
  precoPorEmbalagem   Decimal  @map("preco_por_embalagem") @db.Decimal(19, 4)
  qtdeTotalBase       Decimal  @map("qtde_total_base") @db.Decimal(14, 3)
  precoTotal          Decimal  @map("preco_total") @db.Decimal(19, 4)
  custoPorUnidadeBase Decimal  @map("custo_por_unidade_base") @db.Decimal(19, 6)
  criadoEm            DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  ingrediente Ingrediente          @relation(fields: [ingredienteId], references: [id], onDelete: Restrict)
  usos        LoteUsoIngrediente[]

  @@index([ingredienteId, dataCompra(sort: Desc)])
  @@map("ingrediente_compras")
}

model Receita {
  id               String   @id @default(uuid()) @db.Uuid
  nome             String
  rendimentoPadrao Int      @map("rendimento_padrao")
  custoGas         Decimal? @map("custo_gas") @db.Decimal(19, 4)
  validadeDias     Int?     @map("validade_dias")
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  itens              ReceitaIngrediente[]
  produto            Produto?
  produtosComRecheio Produto[]            @relation("recheio")
  lotes              Lote[]

  @@map("receitas")
}

model ReceitaIngrediente {
  receitaId     String  @map("receita_id") @db.Uuid
  ingredienteId String  @map("ingrediente_id") @db.Uuid
  qtde          Decimal @db.Decimal(14, 3)

  receita     Receita     @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Restrict)

  @@id([receitaId, ingredienteId])
  @@map("receita_ingredientes")
}

model Produto {
  id                   String      @id @default(uuid()) @db.Uuid
  nome                 String
  descricao            String
  categoria            String
  tipo                 TipoProduto
  precoVenda           Decimal     @map("preco_venda") @db.Decimal(19, 4)
  margemMinimaOverride Decimal?    @map("margem_minima_override") @db.Decimal(5, 2)
  receitaId            String?     @unique @map("receita_id") @db.Uuid
  // Recheio (D-12): receita ANEXA opcional, só p/ UNITARIO. Rendimento da
  // receita de recheio é sempre tratado como "por unidade final" (qtde de
  // cada item já é a dose de 1 doce) — escala por rendimentoReal na
  // produção, não pelo multiplicador da base (ver lib/actions/lotes.ts).
  // Não é @unique: a mesma receita de recheio pode atender vários produtos
  // (ex.: "Recheio de nutella" no brownie E no bolo).
  recheioReceitaId     String?     @map("recheio_receita_id") @db.Uuid
  criadoEm             DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  receita        Receita?         @relation(fields: [receitaId], references: [id], onDelete: Restrict)
  receitaRecheio Receita?         @relation("recheio", fields: [recheioReceitaId], references: [id], onDelete: Restrict)
  kitItens       ProdutoKitItem[] @relation("kit")
  emKits         ProdutoKitItem[] @relation("componente")
  lotes          Lote[]

  @@map("produtos")
}

model ProdutoKitItem {
  kitId        String @map("kit_id") @db.Uuid
  componenteId String @map("componente_id") @db.Uuid
  qtde         Int

  kit        Produto @relation("kit", fields: [kitId], references: [id], onDelete: Cascade)
  componente Produto @relation("componente", fields: [componenteId], references: [id], onDelete: Restrict)

  @@id([kitId, componenteId])
  @@map("produto_kit_items")
}

model Lote {
  id                       String   @id @default(uuid()) @db.Uuid
  produtoId                String   @map("produto_id") @db.Uuid
  receitaId                String   @map("receita_id") @db.Uuid
  multiplicador            Decimal  @db.Decimal(6, 2)
  rendimentoReal           Int      @map("rendimento_real")
  produzidoEm              DateTime @default(now()) @map("produzido_em") @db.Timestamptz(6)
  validade                 DateTime @db.Date
  qtdeDisponivel           Int      @map("qtde_disponivel")
  qtdeReservada            Int      @default(0) @map("qtde_reservada")
  custoGasCongelado        Decimal  @map("custo_gas_congelado") @db.Decimal(19, 4)
  custoTotalCongelado      Decimal  @map("custo_total_congelado") @db.Decimal(19, 4)
  custoPorUnidadeCongelado Decimal  @map("custo_por_unidade_congelado") @db.Decimal(19, 6)
  criadoEm                 DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  produto Produto              @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  receita Receita              @relation(fields: [receitaId], references: [id], onDelete: Restrict)
  usos    LoteUsoIngrediente[]

  @@index([validade])
  @@map("lotes")
}

model LoteUsoIngrediente {
  id                     String  @id @default(uuid()) @db.Uuid
  loteId                 String  @map("lote_id") @db.Uuid
  ingredienteCompraId    String  @map("ingrediente_compra_id") @db.Uuid
  qtdeUsada              Decimal @map("qtde_usada") @db.Decimal(14, 3)
  marcaSnapshot          String  @map("marca_snapshot")
  custoUnitarioCongelado Decimal @map("custo_unitario_congelado") @db.Decimal(19, 6)
  custoCongelado         Decimal @map("custo_congelado") @db.Decimal(19, 4)

  lote   Lote              @relation(fields: [loteId], references: [id], onDelete: Cascade)
  compra IngredienteCompra @relation(fields: [ingredienteCompraId], references: [id], onDelete: Restrict)

  @@index([ingredienteCompraId])
  @@map("lote_uso_ingredientes")
}

model Configuracao {
  id                 Int     @id @default(1)
  margemMinimaPadrao Decimal @default(30) @map("margem_minima_padrao") @db.Decimal(5, 2)

  @@map("configuracoes")
}
