# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doces_valentina

# App
NODE_ENV=development
TZ=America/Sao_Paulo
NEXT_PUBLIC_URL=http://localhost:3000

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=__SET_BEFORE_RUNNING_SEED__
BETTER_AUTH_URL=http://localhost:3000

# Audit PII hashing pepper (ME-01) — HMAC key for hashing audit IP/UA.
# >=32 chars; generate with: openssl rand -base64 32
AUDIT_HASH_PEPPER=__SET_BEFORE_RUNNING_SEED__

# Resend (https://resend.com/dashboard/api-keys)
RESEND_API_KEY=re___SET_BEFORE_RUNNING_SEED__
RESEND_WEBHOOK_SECRET=whsec___SET_BEFORE_RUNNING_SEED__

# Admin bootstrap (D-05 / D-07 — used by `npm run seed:admin`)
ADMIN_EMAIL=admin@docesvalentina.com.br
ADMIN_INITIAL_PASSWORD=__SET_BEFORE_RUNNING_SEED__
# ADMIN_RESET_PASSWORD=__USE_ONLY_FOR_RESET__

# Optional — Next.js Server Actions encryption key (rotation control)
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=__GENERATE_VIA_OPENSSL_RAND__
