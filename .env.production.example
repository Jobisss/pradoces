# Doces Valentina — PRODUCTION env template (INFRA-01).
#
# Copy to `.env.production` on the VPS (NEVER commit the real file — it is in
# .gitignore via .env*). docker-compose.yml reads `.env.production` via env_file
# for the app, and ${POSTGRES_PASSWORD} for the db. Generate secrets with:
#   openssl rand -base64 32

# --- Database ---
# Host = the compose service name `db`; DB name matches POSTGRES_DB=doces.
DATABASE_URL=postgresql://postgres:__POSTGRES_PASSWORD__@db:5432/doces
# Also consumed directly by docker-compose for the Postgres container.
POSTGRES_PASSWORD=__SET_STRONG_PASSWORD__

# --- App runtime ---
NODE_ENV=production
TZ=America/Sao_Paulo
NEXT_PUBLIC_URL=https://docesvalentina.com.br

# --- Better Auth (openssl rand -base64 32) ---
BETTER_AUTH_SECRET=__SET_BEFORE_DEPLOY__
BETTER_AUTH_URL=https://docesvalentina.com.br

# --- Resend (https://resend.com/dashboard/api-keys) ---
RESEND_API_KEY=re___SET_BEFORE_DEPLOY__
RESEND_WEBHOOK_SECRET=whsec___SET_BEFORE_DEPLOY__

# --- Admin bootstrap (used by `npm run seed:admin`) ---
ADMIN_EMAIL=admin@docesvalentina.com.br
# ADMIN_INITIAL_PASSWORD=__SET_ONLY_FOR_FIRST_SEED__
