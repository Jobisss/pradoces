# Luizinha Confeitaria — host-level reverse proxy (INFRA-01 / INFRA-02).
# Lives at /etc/caddy/Caddyfile on the VPS (runs on the HOST, not in Docker).
#
# Cloudflare terminates the public TLS; Caddy obtains its own Let's Encrypt cert
# so Cloudflare SSL/TLS mode "Full (Strict)" validates the origin (T-01-05-04).

{
	# Automatic Let's Encrypt issuance/renewal.
	email dpo@luizinha-confeitaria.com.br
}

luizinha-confeitaria.com.br, www.luizinha-confeitaria.com.br {
	encode gzip zstd

	# Cloudflare is the ONLY trusted proxy, so X-Forwarded-For can be believed
	# (T-01-05-03). Requires the caddy-trusted-cloudflare plugin — on Ubuntu
	# 22.04+ the `apt install caddy` package ships it; otherwise build Caddy with
	# `xcaddy build --with github.com/WeidiDeng/caddy-cloudflare-ip` or hardcode
	# the CIDRs that scripts/setup-ufw.sh fetches from cloudflare.com/ips-v4.
	servers {
		trusted_proxies cloudflare
	}

	# HSTS only. CSP / X-Frame-Options / X-Content-Type-Options are owned by the
	# Next.js proxy.ts (Pitfall #10) — do NOT duplicate them here.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# App container is published on loopback only (docker-compose 127.0.0.1:3000).
	reverse_proxy 127.0.0.1:3000
}
